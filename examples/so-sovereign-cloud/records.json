 {
  "type": "measures",
  "body": {
   "effective": "2026-01-01",
   "statement": "Your data stays in the zone you pick, run by Swiss and EU companies only. Nobody here answers to a foreign subpoena, and we have the signed ledger to prove it.",
   "technical": [
    "Encryption at rest for block and object storage, keys held in-zone",
    "Customer-provided keys (SSE-C) for object storage",
    "Administrative access via in-zone bastions with hardware-key MFA and session logging"
   ],
   "organisational": [
    "Every authority request is reviewed by Legal; requests without a valid basis under Swiss or EU law are rejected",
    "Staff with production access are employed by EU/Swiss entities",
    "Annual external audit of access controls"
   ],
   "contractual": [
    "DPA commits to challenge, minimise and notify on third-country requests (Data Act Art. 32)",
    "Subprocessors bound by equivalent obligations and 30-day change notice"
   ]
  }
 },
